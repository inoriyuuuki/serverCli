# =============================================================================
# ServerCLI 根级 .env.example
# 说明：实例级配置请放在 deploy/environments/<env>/<instance>.env（非 Secret）
#      与 <instance>.secrets.env（0600，Secret）。本文件仅为常用默认值参考，
#      复制为 .env 后由脚本自动加载（.env 已被 .gitignore 忽略，不要提交）。
# =============================================================================

APP_ENV=test
INSTANCE_NAME=test-primary
NODE_ROLE=primary

# 主服务器 IP（测试 <test-server-ip> / 正式 <prod-server-ip>）
PRIMARY_SERVER_IP=<test-server-ip>
PRIMARY_BACKEND_URL=http://<test-server-ip>:9045

# 端口（测试主 9044/9045，测试子 9046/9047，正式主 9042/9043）
FRONTEND_ADDR=0.0.0.0:9044
BACKEND_ADDR=0.0.0.0:9045

DATABASE_DRIVER=sqlite
# DATABASE_URL=            # SQLite 留空自动推导；正式 PostgreSQL 放 secrets

# 目录（相对仓库根）
AGENT_STATE_DIR=./state/test-primary
LOG_DIR=./logs/test-primary
COMMANDS_DIR=./commands
FRONTEND_DIST_DIR=./frontend/dist

# AI Lease / 保留 / 心跳（契约 §2 默认值）
AI_LEASE_DEFAULT_MINUTES=60
AI_LEASE_MAX_HOURS=24
AI_LEASE_DISCONNECT_GRACE_SECONDS=60
RETENTION_DAYS=7
CLEANUP_SCHEDULE=weekly
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=90
TASK_POLL_TIMEOUT_SECONDS=25

AUTHORIZED_KEYS_FILE=./state/test-primary/authorized_keys
LEASE_SHELL_BIN=./state/test-primary/bin/servercli-lease-shell
HTTP_INSECURE_SKIP_VERIFY=true
LOG_LEVEL=info

# ---- Secret（仅示例键名；真实值只放 0600 secrets 文件） ----
# ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_PASSWORD_FILE=

# ---- 通知模块（Secret：真实 Webhook 只放 0600 secrets 文件，本文件仅键名） ----
# NOTIFICATION_FEISHU_WEBHOOK_URL=        # 飞书自定义机器人 Webhook（留空=未配置，发送返回 503）
# NOTIFICATION_RATE_LIMIT_PER_TOKEN_PER_MINUTE=30
# NOTIFICATION_RATE_LIMIT_GLOBAL_PER_MINUTE=120

# ---- 部署管理（Deployment Management）----
# 统一部署根目录（节点侧权威同步区 + 运行区）
DEPLOYMENT_ROOT_DIR=/opt/servercli-deployment
