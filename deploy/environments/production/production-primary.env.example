# =============================================================================
# ServerCLI 正式环境 - 主节点（production-primary）非 Secret 配置
# 复制为 production-primary.env 使用；Secret（数据库密码、管理员初始密码）
# 请放在同目录 production-primary.secrets.env（必须 0600，且不得提交 Git）
# 正式环境所有操作必须：./scripts/*.sh --env production --confirm-production
# =============================================================================
APP_ENV=production
INSTANCE_NAME=production-primary
NODE_ROLE=primary

# 正式主服务器 IP（权威值，见 doc/03 §1）
PRIMARY_SERVER_IP=<prod-server-ip>
PRIMARY_BACKEND_URL=https://<prod-server-ip>:9043

# 端口（权威：正式前端 9042 / 后端 9043）
FRONTEND_ADDR=0.0.0.0:9042
BACKEND_ADDR=0.0.0.0:9043

# 数据库：正式使用 PostgreSQL（连接串为 Secret，放在 secrets 文件）
DATABASE_DRIVER=postgres
DATABASE_URL=

# 目录（正式建议使用系统路径；脚本支持相对路径按仓库根解析）
AGENT_STATE_DIR=/var/lib/servercli/production-primary
LOG_DIR=/var/log/servercli/production-primary
COMMANDS_DIR=/opt/servercli/commands
FRONTEND_DIST_DIR=/opt/servercli/frontend/dist

# AI SSH Lease
AI_LEASE_DEFAULT_MINUTES=60
AI_LEASE_MAX_HOURS=24
AI_LEASE_DISCONNECT_GRACE_SECONDS=60

# 保留与清理
RETENTION_DAYS=7
CLEANUP_SCHEDULE=weekly

# 心跳 / 离线 / 任务轮询
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=90
TASK_POLL_TIMEOUT_SECONDS=25

# AI 临时公钥授权文件与 lease-shell 包装器
AUTHORIZED_KEYS_FILE=/var/lib/servercli/production-primary/authorized_keys
LEASE_SHELL_BIN=/var/lib/servercli/production-primary/bin/servercli-lease-shell

# 正式环境必须使用受信任 TLS（经反向代理或证书）；禁止跳过证书校验
HTTP_INSECURE_SKIP_VERIFY=false
LOG_LEVEL=info
