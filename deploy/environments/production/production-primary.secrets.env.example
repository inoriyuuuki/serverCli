# =============================================================================
# ServerCLI 正式环境 - 主节点 Secret 占位模板（production-primary）
#
# ⚠️⚠️ 仅部署机使用，权限必须为 0600，严禁提交真实值到 Git / 日志 / 命令行！
# 复制为 production-primary.secrets.env 后由部署机管理员手工填写。
# 本文件只应存在于部署机，任何 CI/仓库路径都不允许出现真实 Secret。
# =============================================================================

# 管理员初始密码（运行时注入，首次初始化后即失效并建议轮换）
ADMIN_INITIAL_PASSWORD=
# 或改为指向 0600 密码文件（推荐，避免出现在环境文件历史中）：
# ADMIN_INITIAL_PASSWORD_FILE=/etc/servercli/production-primary/admin-password

# PostgreSQL 连接串（必须填写；含密码，仅存于本 0600 文件）
# 示例格式: postgres://servercli:CHANGE_ME@127.0.0.1:5432/servercli?sslmode=require
DATABASE_URL=

# 通知 Webhook（飞书群机器人）。真实值仅放本 0600 文件，严禁提交 Git / 日志 / 命令行 / 示例。
# 未配置时服务可启动，通知发送返回 503 NOT_CONFIGURED（GET /notice 返回 200/ret=0）。
# 旧 Flask Webhook 已泄露，需在飞书侧废弃重建后再填入新值（见 doc/12_NOTIFICATION_MIGRATION.md）。
# 占位示例（不要写真实值）：NOTIFICATION_FEISHU_WEBHOOK_URL=<feishu-webhook-url>
NOTIFICATION_FEISHU_WEBHOOK_URL=
