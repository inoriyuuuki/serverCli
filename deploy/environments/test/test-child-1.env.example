# =============================================================================
# ServerCLI 测试环境 - 子节点逻辑实例（test-child-1）非 Secret 配置
# 复制为 test-child-1.env 使用；Secret 请放在同目录 test-child-1.secrets.env（0600）
# 测试主/子共用 <test-server-ip>，必须用 node_id + role + 端口区分（doc/03 §1.1）
# =============================================================================
APP_ENV=test
INSTANCE_NAME=test-child-1
NODE_ROLE=child

# 主服务器 IP（测试环境权威值）
PRIMARY_SERVER_IP=<test-server-ip>
# 子节点向主控注册的基础 URL；同机联调可改为 http://127.0.0.1:9045
PRIMARY_BACKEND_URL=http://<test-server-ip>:9045

# 端口（权威：测试子前端 9046 / 后端 9047）
FRONTEND_ADDR=0.0.0.0:9046
BACKEND_ADDR=0.0.0.0:9047

# 数据库：子实例本机独立 SQLite/文件（doc/03 §1），不直接连正式库
DATABASE_DRIVER=sqlite
DATABASE_URL=

# 目录（相对仓库根；与主实例隔离）
AGENT_STATE_DIR=./state/test-child-1
LOG_DIR=./logs/test-child-1
COMMANDS_DIR=./commands
FRONTEND_DIST_DIR=./frontend/dist

# AI SSH Lease
AI_LEASE_DEFAULT_MINUTES=60
AI_LEASE_MAX_HOURS=24
AI_LEASE_DISCONNECT_GRACE_SECONDS=60

# 保留与清理
RETENTION_DAYS=7
CLEANUP_SCHEDULE=weekly

# 心跳 / 离线 / 任务轮询
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=90
TASK_POLL_TIMEOUT_SECONDS=25

# AI 临时公钥授权文件与 lease-shell 包装器
AUTHORIZED_KEYS_FILE=./state/test-child-1/authorized_keys
LEASE_SHELL_BIN=./state/test-child-1/bin/servercli-lease-shell

HTTP_INSECURE_SKIP_VERIFY=true
LOG_LEVEL=info
