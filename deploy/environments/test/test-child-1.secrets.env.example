# =============================================================================
# ServerCLI 测试环境 - 子节点 Secret 占位模板（test-child-1）
#
# ⚠️  仅部署机使用，权限必须为 0600，不得提交真实值到 Git！
# 复制为 test-child-1.secrets.env 后使用；scripts 会自动 chmod 600。
# 子实例通常由主节点统一管理，本机可无管理员密码（留空即可）。
# =============================================================================

ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_PASSWORD_FILE=/path/to/admin-password

# 子实例独立 SQLite 可留空（默认 file:<AGENT_STATE_DIR>/servercli.db）：
# DATABASE_URL=file:/absolute/path/to/test-child-1.db
