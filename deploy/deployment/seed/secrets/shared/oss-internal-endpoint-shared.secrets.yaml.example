# =============================================================================
# V1 明文 Secret 模板 — OSS Internal Endpoint (oss-internal-endpoint)
# profile: oss-internal-endpoint-shared
# 警告：V1 明文存私有 OSS，禁止提交真实值！
# 本文件为 .example 模板：只含键名与占位值（xxx-placeholder-xxx）。
# 真实 Secret 由控制面写入私有 OSS，权限 0600；禁止进入 Git。
# =============================================================================
version: 1
profile: oss-internal-endpoint-shared
secrets:
  oss_access_key_id: xxx-placeholder-xxx
  oss_access_key_secret: xxx-placeholder-xxx
