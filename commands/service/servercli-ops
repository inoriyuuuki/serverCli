#!/bin/sh
#
# servercli-ops —— 在节点上执行 ServerCLI 迁移/运维操作（root）。
#
# Operation V2 结构化任务：控制面通过 Agent 派发，任务参数包含
#   operation_request（结构化 JSON，写入 0600 SERVERCLI_OPERATION_CONTEXT）
#   _secrets（可选，写入 0700 SERVERCLI_SECRET_DIR 下每个 0600 文件）
# 本脚本只读取上下文文件，绝不把 Secret 放入 argv；参数顺序不再重要。
set -eu

CONTEXT="${SERVERCLI_OPERATION_CONTEXT:-}"
SECRET_DIR="${SERVERCLI_SECRET_DIR:-}"

SERVERCLI_BIN=""
for cand in /home/inori/serverCli/bin/servercli /opt/servercli/bin/servercli /usr/local/bin/servercli; do
  if [ -x "$cand" ]; then SERVERCLI_BIN="$cand"; break; fi
done
if [ -z "$SERVERCLI_BIN" ]; then
  echo "servercli-ops: servercli binary not found" >&2
  exit 3
fi
if [ -z "$CONTEXT" ]; then
  echo "servercli-ops: SERVERCLI_OPERATION_CONTEXT is required for structured tasks" >&2
  exit 2
fi
if [ ! -r "$CONTEXT" ]; then
  echo "servercli-ops: operation context not readable: $CONTEXT" >&2
  exit 2
fi

op="$(sed -n 's/.*"operation_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONTEXT" | head -1)"
service="$(sed -n 's/.*"module_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONTEXT" | head -1)"
backup_id="$(sed -n 's/.*"backup_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONTEXT" | head -1)"

if [ -z "$op" ] || [ -z "$service" ]; then
  echo "servercli-ops: operation_type and module_id are required in the operation context" >&2
  exit 2
fi

# Secret dir, when present, is passed to servercli via env (never argv).
ENV_SECRETS=""
if [ -n "$SECRET_DIR" ] && [ -d "$SECRET_DIR" ]; then
  ENV_SECRETS="SERVERCLI_SECRET_DIR=$SECRET_DIR"
fi

case "$op" in
  adopt|update|backup)
    if [ -n "$ENV_SECRETS" ]; then
      exec env "$ENV_SECRETS" sudo -n "$SERVERCLI_BIN" ops "$op" "$service" --yes
    else
      exec sudo -n "$SERVERCLI_BIN" ops "$op" "$service" --yes
    fi
    ;;
  restore)
    if [ -z "$backup_id" ]; then
      echo "servercli-ops: restore requires backup_id in the operation context" >&2
      exit 2
    fi
    if [ -n "$ENV_SECRETS" ]; then
      exec env "$ENV_SECRETS" sudo -n "$SERVERCLI_BIN" ops restore "$service" "$backup_id" --yes
    else
      exec sudo -n "$SERVERCLI_BIN" ops restore "$service" "$backup_id" --yes
    fi
    ;;
  *)
    echo "servercli-ops: unsupported operation: $op" >&2
    exit 2
    ;;
esac
